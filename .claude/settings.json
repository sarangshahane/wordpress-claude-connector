{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "autoCompactThreshold": 50,

  "permissions": {
    "allow": [
      "Bash(npm start)",
      "Bash(npm run package)",
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "Bash(npm run test)",
      "Bash(npm run test *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push * --force)"
    ]
  },

  "spinnerVerbs": {
    "mode": "append",
    "verbs": [
      "Analyzing patterns",
      "Reviewing architecture",
      "Running checks",
      "Scanning for issues",
      "Validating structure"
    ]
  }
}
