{
  "name": "wordpress-claude-connector-desktop",
  "version": "1.0.0",
  "description": "Desktop installer to connect Claude Desktop with WordPress via MCP Adapter",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . wordpress-claude-connector --platform=darwin --arch=x64 --overwrite --icon=assets/icon.icns",
    "build": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {
    "fs-extra": "^11.2.0"
  },
  "build": {
    "appId": "com.wordpress.claude.connector",
    "productName": "WordPress Claude Connector",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        }
      ],
      "icon": "assets/icon.icns",
      "minimumSystemVersion": "10.13",
      "category": "public.app-category.developer-tools"
    }
  }
}